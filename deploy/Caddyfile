# Caddy na frente do front: HTTPS automático (Let's Encrypt) para o domínio
# definido em DOMAIN no .env. Tudo que chega vai para o nginx do serviço `web`,
# que serve o front e repassa /api para a API.
#
# www recebe certificado próprio e redireciona para o domínio sem www — um
# endereço canônico só, para cookies, links e CORS não se dividirem.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

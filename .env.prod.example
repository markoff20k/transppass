# Copie para .env no servidor e preencha. Usado pelo docker-compose.prod.yml.

# ---- Banco (container postgres) ----
POSTGRES_USER=transppass
# Só letras e números (a senha entra numa URL). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
POSTGRES_DB=transppass_pcm

# ---- API ----
# Gere cada um com: openssl rand -base64 48
JWT_ACCESS_SECRET=TROQUE_ME_ACCESS
JWT_REFRESH_SECRET=TROQUE_ME_REFRESH
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Domínio (Caddy emite o certificado HTTPS para ele) ----
DOMAIN=transppass.online
# Origem do front, com https e o mesmo domínio
CORS_ORIGIN=https://transppass.online

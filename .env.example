# ---- API ----
NODE_ENV=development
PORT=3000
# Container do docker-compose (porta 5433 para nao colidir com o PostgreSQL local):
DATABASE_URL="postgresql://app:app@localhost:5433/app?schema=public"
# Alternativa usando o PostgreSQL 17 ja instalado na maquina:
# DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/novo_sistema?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-me-access
JWT_REFRESH_SECRET=troque-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173

# ---- WEB ----
VITE_API_URL=http://localhost:3000

# ---- API ----
NODE_ENV=development
PORT=3000
# Container do docker-compose (porta 5433 para nao colidir com o PostgreSQL local):
DATABASE_URL="postgresql://app:app@localhost:5433/app?schema=public"
# Alternativa usando o PostgreSQL 17 ja instalado na maquina:
# DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/novo_sistema?schema=public"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-me-access
JWT_REFRESH_SECRET=troque-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173

# ---- WEB ----
VITE_API_URL=http://localhost:3000

# Simulador de demonstracao: a garagem anda sozinha (telemetria, falhas, oficina, plantao). Nunca em producao com dados reais.
DEMO_SIMULATOR=false

# ---- ia.Transppass (agente de PCM) ----
# Chave da Anthropic. Com ela o agente responde pelo modelo abaixo; sem ela o agente fica desligado.
ANTHROPIC_API_KEY=
# anthropic (padrao quando ha chave) | fake (provedor simulado para desenvolvimento e QA, sem custo) | off
IA_PROVIDER=
IA_MODEL=claude-opus-5-5
# Hora (0-23) em que a leitura do mes dos Indicadores e redigida pelo modelo, todo dia.
IA_READING_HOUR=3

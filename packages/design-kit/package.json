{
  "name": "@app/design-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Design kit do Transppass PCM — tokens, tema claro/escuro e componentes",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./css": "./src/css/index.css",
    "./css/*": "./src/css/*"
  },
  "files": ["dist", "src/css"],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/finalize-dist.mjs",
    "dev": "concurrently -n cjs,esm \"tsc -p tsconfig.cjs.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.esm.json --watch --preserveWatchOutput\"",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "devDependencies": {
    "@app/config": "*",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
